{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "./src/server.ts",
  "scripts": {
    "dev": "ts-node-dev --require tsconfig-paths/register src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "lint": "eslint . --ext .ts,.tsx",
    "generate-swagger": "ts-node src/scripts/generateSwagger.ts",
    "generate-api-doc": "widdershins swagger.json -o api-docs.md --code",
    "generate-fake-data": "ts-node src/scripts/generateFakeData.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:controllers": "jest --coverage --collectCoverageFrom=\"src/controllers/**/*.ts\"",
    "test:services": "jest --coverage --collectCoverageFrom=\"src/services/**/*.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@jest/types": "^29.6.3",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "nanoid": "^3.3.11",
    "socket.io": "^4.8.1",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "bcryptjs": "^3.0.2",
    "eslint": "^9.25.1",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "supertest": "^7.1.1",
    "ts-jest": "^29.3.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "widdershins": "^3.6.7"
  }
}
